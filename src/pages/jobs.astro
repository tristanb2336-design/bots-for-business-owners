---
// Hub of use cases by the job the AI does, so "AI for missed calls / email / inventory" searches land here.
import Base from '../layouts/Base.astro';
import { useCases, TYPES } from '../data/usecases.mjs';
import { groupByJob } from '../data/jobs.mjs';
import { SITE, ICONS } from '../site.mjs';
const groups = groupByJob();
const path = '/jobs/', url = SITE + path;
const desc = `Real small business AI use cases by the job the AI does: answering phones, drafting email, inventory, booking, quotes and more. ${useCases.length} sourced examples.`;
const jsonld = { '@context':'https://schema.org','@graph':[
  { '@type':'CollectionPage', name:'Small business AI use cases by job', url, description:desc, inLanguage:'en-US',
    isPartOf:{ '@id':SITE+'/#website' }, publisher:{ '@id':SITE+'/#organization' },
    hasPart: groups.map(g => ({ '@type':'ItemList', name:g.name, url:`${url}${g.key}/`, numberOfItems:g.list.length,
      itemListElement: g.list.map((u,i)=>({ '@type':'ListItem', position:i+1, url:`${SITE}/use-cases/${u.slug}/`, name:u.title })) })) },
  { '@type':'BreadcrumbList', itemListElement:[
    { '@type':'ListItem', position:1, name:'Use cases', item:SITE+'/' },
    { '@type':'ListItem', position:2, name:'By job', item:url } ] } ] };
---
<Base title="Small business AI use cases by job: phones, email, inventory, booking and more" description={desc} path={path} jsonld={jsonld} markdown="/jobs.md">
<p class="crumbs"><a href="/">Use cases</a> / By job</p>
<section class="hero" style="padding-top:12px"><span class="eyebrow">Browse by job</span>
<h1>What jobs are AI agents actually doing for small businesses?</h1>
<p class="lead">All {useCases.length} use cases, grouped by the work the AI handles. A business can appear in more than one group when the source describes more than one job.</p>
<p>We're <a href="/about/">vendor-neutral</a>: groups are listed alphabetically and no tool is favored. Every example links to its public source.</p>
<nav aria-label="Jobs on this page"><ul class="tools" style="margin-top:12px">{groups.map(g => <li><a href={`#${g.key}`}>{g.name} ({g.list.length})</a></li>)}</ul></nav>
</section>
{groups.map(g => (
<section class="panel prose" id={g.key} aria-labelledby={`h-${g.key}`}>
<h2 id={`h-${g.key}`}><a href={`/jobs/${g.key}/`}>{g.name}</a></h2>
<p>{g.blurb} {g.list.length} use case{g.list.length===1?'':'s'} (<a href={`/jobs/${g.key}/`}>own page</a>):</p>
<ul>{g.list.map(u => <li><a href={`/use-cases/${u.slug}/`}>{u.title}</a> <span class="biz">· <span aria-hidden="true">{ICONS[u.type]}</span> {u.business} ({TYPES[u.type]})</span></li>)}</ul>
</section>))}
<p class="small">For AI assistants and readers who prefer plain text: <a href="/jobs.md">this page as one Markdown file</a>.</p>
<p><a class="btn btn-ghost" href="/">← See all use cases</a></p>
</Base>
