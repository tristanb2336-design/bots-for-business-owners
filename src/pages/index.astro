---
import Base from '../layouts/Base.astro';
import { useCases, TYPES } from '../data/usecases.mjs';
import { SITE, NAME, TAGLINE } from '../site.mjs';
import { short } from '../components.mjs';
import Card from '../components/Card.astro';
import Signup from '../components/Signup.astro';
import Featured from '../components/Featured.astro';
import { ICONS } from '../site.mjs';
const counts = Object.fromEntries(Object.keys(TYPES).map(k => [k, useCases.filter(u => u.type === k).length]));
const jsonld = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebSite', name: NAME, url: SITE + '/', description: TAGLINE },
  { '@type': 'ItemList', name: 'AI agent use cases for small business owners', numberOfItems: useCases.length,
    itemListElement: useCases.map((u, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}/use-cases/${u.slug}/`, name: u.title })) } ] };
---
<Base title={`${NAME}: ${useCases.length} real ways small business owners use AI agents`} description={`${useCases.length} real, sourced examples of restaurants, shops, landlords, trades and service businesses using AI agents, with how to start in plain English.`} jsonld={jsonld}>
<section class="hero hero-split">
<div>
<span class="eyebrow">Free · Sourced · Plain English</span>
<h1>See how owners like you <em>put AI to work</em>, and how to start</h1>
<p class="lead">{useCases.length} real businesses: pizzerias, plumbers, landlords, shops. What the AI does, the tools they used, and the first steps. No tech skills needed.</p>
<div class="cta"><a class="btn btn-primary" href="#browse">Browse the {useCases.length} use cases ↓</a><a class="link-quiet" href="/about/">How we pick them</a></div>
<div class="trust"><span>Real businesses only</span><span>Source linked on every page</span><span>No jargon</span></div>
</div>
<div class="hero-card" aria-hidden="true">
<p class="hc-title">On every use case page</p>
<ul><li><span>🧰</span>The job the AI does</li><li><span>🛠️</span>Tools the owner used</li><li><span>💵</span>Cost, when the source says</li><li><span>🪜</span>How to start, step by step</li><li><span>🔗</span>A link to the real source</li></ul>
</div>
</section>
<h2 class="section-title">Find your kind of business</h2>
<nav aria-label="Business types"><div class="types">{Object.entries(TYPES).map(([k, v]) => <a class="type-tile" href={`/type/${k}/`}><span class="ic" aria-hidden="true">{ICONS[k]}</span><span>{v}</span><small>{`${counts[k]} use case${counts[k]===1?'':'s'}`}</small></a>)}</div></nav>
<p><a class="link-quiet" href="/tools/">Or browse by AI tool: ChatGPT, Claude, Gemini, Copilot, phone agents →</a></p>
<h2 class="section-title" id="browse" style="margin-top:32px">All {useCases.length} use cases</h2>
<Featured />
<div class="grid" id="list">{useCases.slice(0, 6).map(u => <Card u={u} />)}</div>
<Signup id="wl-mid" compact title="Want one of these in your inbox each week?" />
<div class="grid" id="list-more">{useCases.slice(6).map(u => <Card u={u} />)}</div>
<div class="more-wrap" id="more-wrap" hidden><button type="button" class="btn btn-ghost" id="show-more" aria-controls="list-more">Show 12 more</button> <a class="link-quiet" href="/tools/">or browse by AI tool</a></div>
<script is:inline>(function(){var g=document.getElementById('list-more'),w=document.getElementById('more-wrap'),b=document.getElementById('show-more');if(!g)return;var c=[].slice.call(g.querySelectorAll('.card')),n=6,step=12;if(c.length<=n)return;g.classList.add('js-paged');function upd(){c.forEach(function(e,i){e.classList.toggle('is-hidden',i>=n)});var left=c.length-n;w.hidden=left<=0;b.textContent='Show '+Math.min(step,left)+' more ('+left+' left)';}b.addEventListener('click',function(){var first=n;n+=step;upd();if(c[first])c[first].focus();});upd();})();</script>
<Signup id="wl-end" />
</Base>
