---
import Base from '../../layouts/Base.astro';
import { useCases, TYPES } from '../../data/usecases.mjs';
import { SITE } from '../../site.mjs';
import Card from '../../components/Card.astro';
import { ICONS } from '../../site.mjs';
export function getStaticPaths(){ return Object.keys(TYPES).map(type => ({ params: { type } })); }
const { type } = Astro.params; const label = TYPES[type];
const list = useCases.filter(u => u.type === type);
const jsonld = { '@context':'https://schema.org','@type':'CollectionPage', name:`AI agent use cases: ${label}`, url:`${SITE}/type/${type}/`,
  mainEntity:{ '@type':'ItemList', itemListElement: list.map((u,i)=>({ '@type':'ListItem', position:i+1, url:`${SITE}/use-cases/${u.slug}/`, name:u.title })) } };
---
<Base title={`AI agents for ${label}: ${list.length} real examples`} description={`Real, sourced examples of how ${label.toLowerCase()} owners use AI agents, and how to start in plain English.`} path={`/type/${type}/`} jsonld={jsonld}>
<p class="crumbs"><a href="/">Use cases</a> / {label}</p>
<section class="hero" style="padding-top:12px"><span class="eyebrow"><span aria-hidden="true">{ICONS[type]}</span> {label}</span>
<h1>AI agents for {label.toLowerCase()}</h1>
<p class="lead">{list.length} real example{list.length===1?'':'s'}, each linked to its public source.</p></section>
<div class="grid">{list.map(u => <Card u={u} />)}</div>
<p><a class="btn btn-ghost" href="/">← See all use cases</a></p>
</Base>
