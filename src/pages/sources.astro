---
// Hub of use cases by the public source host they cite (trust / attribution).
import Base from '../layouts/Base.astro';
import { useCases, TYPES } from '../data/usecases.mjs';
import { groupBySource, PAGE_MIN } from '../data/sources.mjs';
import { SITE, ICONS } from '../site.mjs';
const groups = groupBySource();
const cited = groups.reduce((n, g) => n + g.list.length, 0);
const path = '/sources/', url = SITE + path;
const desc = `Every Bots for Business Owners use case links a public source. Browse ${cited} examples by the site they were reported on (${groups.length} sources).`;
const jsonld = { '@context':'https://schema.org','@graph':[
  { '@type':'CollectionPage', name:'Small business AI use cases by source', url, description:desc, inLanguage:'en-US',
    isPartOf:{ '@id':SITE+'/#website' }, publisher:{ '@id':SITE+'/#organization' },
    hasPart: groups.map(g => ({ '@type':'ItemList', name:`Use cases sourced from ${g.name}`, ...(g.list.length >= PAGE_MIN ? { url:`${url}${g.key}/` } : {}), numberOfItems:g.list.length,
      itemListElement: g.list.map((u,i)=>({ '@type':'ListItem', position:i+1, url:`${SITE}/use-cases/${u.slug}/`, name:u.title })) })) },
  { '@type':'BreadcrumbList', itemListElement:[
    { '@type':'ListItem', position:1, name:'Use cases', item:SITE+'/' },
    { '@type':'ListItem', position:2, name:'By source', item:url } ] } ] };
---
<Base title="Small business AI use cases by source: where every example was reported" description={desc} path={path} jsonld={jsonld} markdown="/sources.md">
<p class="crumbs"><a href="/">Use cases</a> / By source</p>
<section class="hero" style="padding-top:12px"><span class="eyebrow">Browse by source</span>
<h1>Where do these AI use cases come from?</h1>
<p class="lead">{cited} of {useCases.length} use cases, grouped by the public site that reported them ({groups.length} sources). Every entry still links straight to that original page.</p>
<p>We're <a href="/about/">vendor-neutral</a>: sources are listed by how many examples they contribute, then alphabetically. Vendor case studies are real customers, but the vendor wrote the story—read them with care.</p>
<nav aria-label="Sources on this page"><ul class="tools" style="margin-top:12px">{groups.map(g => <li><a href={`#${g.key}`}>{g.name} ({g.list.length})</a></li>)}</ul></nav>
</section>
{groups.map(g => (
<section class="panel prose" id={g.key} aria-labelledby={`h-${g.key}`}>
<h2 id={`h-${g.key}`}>{g.list.length >= PAGE_MIN ? <a href={`/sources/${g.key}/`}>{g.name}</a> : g.name}</h2>
<p>{g.list.length} use case{g.list.length===1?'':'s'}{g.list.length >= PAGE_MIN ? <> (<a href={`/sources/${g.key}/`}>own page</a>)</> : ''}:</p>
<ul>{g.list.map(u => <li><a href={`/use-cases/${u.slug}/`}>{u.title}</a> <span class="biz">· <span aria-hidden="true">{ICONS[u.type]}</span> {u.business} ({TYPES[u.type]})</span> · <a href={u.sourceUrl} rel="noopener">source</a></li>)}</ul>
</section>))}
<p class="small">For AI assistants and readers who prefer plain text: <a href="/sources.md">this page as one Markdown file</a>.</p>
<p><a class="btn btn-ghost" href="/">← See all use cases</a></p>
</Base>
