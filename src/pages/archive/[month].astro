---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { TYPES } from '../../data/usecases.mjs';
import { groupByMonth } from '../../data/archive.mjs';
import { SITE } from '../../site.mjs';
export function getStaticPaths(){
  return groupByMonth().map(g => ({ params: { month: g.key }, props: { g } }));
}
const { g } = Astro.props;
const list = g.list;
const path = `/archive/${g.key}/`, url = SITE + path;
const types = [...new Set(list.map(u => u.type))].map(t => TYPES[t]);
const desc = `${list.length} real, sourced small-business AI use cases added in ${g.name}: what the AI does, stated results and how to start.`;
const others = groupByMonth().filter(x => x.key !== g.key);
const jsonld = { '@context':'https://schema.org','@graph':[
  { '@type':'CollectionPage', name:`Use cases added in ${g.name}`, url, description:desc, inLanguage:'en-US',
    isPartOf:{ '@id':SITE+'/#website' }, publisher:{ '@id':SITE+'/#organization' },
    mainEntity:{ '@type':'ItemList', numberOfItems:list.length, itemListElement: list.map((u,i)=>({ '@type':'ListItem', position:i+1, url:`${SITE}/use-cases/${u.slug}/`, name:u.title })) } },
  { '@type':'BreadcrumbList', itemListElement:[
    { '@type':'ListItem', position:1, name:'Use cases', item:SITE+'/' },
    { '@type':'ListItem', position:2, name:'By month added', item:SITE+'/archive/' },
    { '@type':'ListItem', position:3, name:g.name, item:url } ] } ] };
---
<Base title={`Added in ${g.name}: ${list.length} small business AI use case${list.length===1?'':'s'}`} description={desc} path={path} jsonld={jsonld} markdown={`/archive/${g.key}.md`}>
<p class="crumbs"><a href="/">Use cases</a> / <a href="/archive/">By month added</a> / {g.name}</p>
<section class="hero" style="padding-top:12px"><span class="eyebrow">By month added</span>
<h1>Use cases added in {g.name}</h1>
<p class="lead">{list.length} real example{list.length===1?'':'s'} published this month, each linked to its public source. Newest in the month first.</p>
<p class="biz" style="font-size:.95rem"><b>Business types:</b> {types.join(', ')}. We're <a href="/about/">vendor-neutral</a>.</p>
</section>
<div class="grid">{list.map(u => <Card u={u} />)}</div>
{others.length ? <section class="panel prose" aria-labelledby="h-other-months"><h2 id="h-other-months">Other months</h2>
<ul class="tools">{others.map(x => <li class="tool-li"><a class="tool-link" href={`/archive/${x.key}/`}>{x.name} ({x.list.length})</a></li>)}</ul></section> : null}
<p class="biz" style="font-size:.9rem">For AI assistants: <a href={`/archive/${g.key}.md`}>this list as plain Markdown</a>.</p>
<p><a class="btn btn-ghost" href="/archive/">← All use cases by month</a></p>
</Base>
