---
import Base from '../../layouts/Base.astro';
import { useCases, TYPES } from '../../data/usecases.mjs';
import { SITE, NAME } from '../../site.mjs';
import { short } from '../../components.mjs';
import Card from '../../components/Card.astro';
import Signup from '../../components/Signup.astro';
import { ICONS } from '../../site.mjs';
import { TOOL_GROUPS } from '../../data/tools.mjs';
export function getStaticPaths(){ return useCases.map(u => ({ params: { slug: u.slug }, props: { u } })); }
const { u } = Astro.props;
const path = `/use-cases/${u.slug}/`, url = SITE + path;
const related = useCases.filter(x => x.type === u.type && x.slug !== u.slug).slice(0, 3);
// Cross-links by AI tool: which /tools/ groups this entry belongs to, plus up to 3 other entries using the same tool.
const myGroups = TOOL_GROUPS.filter(g => u.tools.some(t => g.match.test(t)));
const toolLinks = myGroups.length ? myGroups.map(g => ({ key: g.key, name: g.name })) : [{ key: 'other', name: 'Other AI agents and custom setups' }];
const shown = new Set([u.slug, ...related.map(r => r.slug)]);
const sameTool = myGroups.flatMap(g => useCases.filter(x => x.tools.some(t => g.match.test(t))).map(x => ({ x, g })))
  .filter(({ x }) => !shown.has(x.slug) && (shown.add(x.slug), true)).slice(0, 3);
// Named AI products this entry uses, as SoftwareApplication entities with their maker, so search engines and AI assistants
// can connect the story to the product (e.g. "small businesses using Gemini"). Multi-vendor groups ("Various ...") are skipped.
const softwareMentions = myGroups.filter(g => !/^Various/.test(g.maker)).map(g => ({ '@type':'SoftwareApplication', name:g.name,
  applicationCategory:'BusinessApplication', creator:{ '@type':'Organization', name:g.maker }, url:`${SITE}/tools/#${g.key}` }));
// Question-and-answer pairs built only from fields shown on the page, so AI assistants and search engines can lift a direct
// answer to "what did it cost?" or "which AI tool did they use?". Questions without a stated answer are left out.
const factOf = f => !f ? null : (typeof f === 'string' ? f : f.basis === 'list-price' ? `Tool list price: ${f.value} (list price, not what they paid).` : f.value);
const bizName = u.business.split(' (')[0];
const qa = [
  [`What does the AI do for ${bizName}?`, u.job],
  u.tools.length > 0 && [`Which AI tools does ${bizName} use?`, u.tools.join(', ') + '.'],
  factOf(u.cost) && [`What did ${bizName}'s AI setup cost?`, factOf(u.cost)],
  factOf(u.setupTime ?? u.setup) && [`How long did setup take at ${bizName}?`, factOf(u.setupTime ?? u.setup)],
  u.results.length > 0 && [`What results does the source report?`, u.results.join(' ')],
].filter(Boolean);
const jsonld = { '@context':'https://schema.org','@graph':[
 { '@type':'FAQPage', mainEntity: qa.map(([q, a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } })) },
 { '@type':'Article', headline:u.title, description:short(u.job), url, mainEntityOfPage:url, image:SITE+'/og.png',
   about:{ '@type':'Organization', name:u.business }, publisher:{ '@id':SITE+'/#organization' }, author:{ '@id':SITE+'/#organization' }, isPartOf:{ '@id':SITE+'/#website' }, publishingPrinciples:SITE+'/about/',
   datePublished:u.added, dateModified:u.updated ?? u.added, inLanguage:'en-US',
   citation:{ '@type':'CreativeWork', name:u.sourceName, url:u.sourceUrl }, isBasedOn:u.sourceUrl, ...(softwareMentions.length ? { mentions:softwareMentions } : {}), keywords:[TYPES[u.type], 'AI agent', 'small business', ...u.tools].join(', ') },
 { '@type':'HowTo', name:`How to start: ${u.title}`, step:u.start.map((s,i)=>({ '@type':'HowToStep', position:i+1, text:s })) },
 { '@type':'BreadcrumbList', itemListElement:[
   { '@type':'ListItem', position:1, name:'Use cases', item:SITE+'/' },
   { '@type':'ListItem', position:2, name:TYPES[u.type], item:`${SITE}/type/${u.type}/` },
   { '@type':'ListItem', position:3, name:u.title, item:url } ] } ] };
// cost / setupTime: null | { value, basis: 'source' | 'list-price', note, url }. Plain strings are treated as source-stated.
const fact = f => !f ? null : (typeof f === 'string' ? { value: f, basis: 'source', note: 'Stated in the source.', url: null } : f);
const cost = fact(u.cost), setupTime = fact(u.setupTime ?? u.setup);
const missing = [!cost && 'cost', !setupTime && 'setup time'].filter(Boolean);
const label = f => f.basis === 'list-price' ? 'Tool list price: ' : '';
const shareText = encodeURIComponent(u.title);
const addedLabel = new Date(u.added + 'T12:00:00Z').toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric', timeZone:'UTC' });
---
<Base title={u.title} description={short(`${u.business}: ${u.job}`)} path={path} jsonld={jsonld} ogType="article" published={u.added} section={TYPES[u.type]} markdown={`/use-cases/${u.slug}.md`}>
<p class="crumbs"><a href="/">Use cases</a> / <a href={`/type/${u.type}/`}>{TYPES[u.type]}</a></p>
<header class="entry-head"><span class="badge"><span class="ic" aria-hidden="true">{ICONS[u.type]}</span>{TYPES[u.type]}</span>
<h1>{u.title}</h1><p class="biz">{u.business}</p>
<p class="biz" style="font-size:.9rem">Added <time datetime={u.added}>{addedLabel}</time></p>
{(cost || setupTime || u.tools.length > 0) && (<ul class="quick" aria-label="At a glance">
{cost && <li><span aria-hidden="true">💵</span><b>Cost</b><span>{label(cost)}{cost.value}{cost.basis === 'list-price' && <small class="lp-note">List price, not what they paid</small>}</span></li>}
{setupTime && <li><span aria-hidden="true">⏱️</span><b>Setup time</b><span>{setupTime.value}</span></li>}
{u.tools.length > 0 && <li><span aria-hidden="true">🧰</span><b>What you need</b><span>{u.tools.join(', ')}</span></li>}
</ul>)}</header>
<div class="entry">
<article class="prose">
<h2>The job the AI does</h2><p>{u.job}</p>
<h2>The story</h2><p>{u.story}</p>
{u.results.length > 0 && (<div class="results"><h2>What the source reports</h2><ul>{u.results.map(r => <li>{r}</li>)}</ul></div>)}
<h2>How to start (plain English)</h2><ol class="steps">{u.start.map(s => <li>{s}</li>)}</ol>
<Signup id="wl-entry" compact title="Want one of these every week?" />
</article>
<aside class="side" aria-label="Details">
<div class="panel" role="group" aria-label="Quick facts"><dl class="facts">
<dt>Business</dt><dd>{u.business}</dd>
<dt>Type</dt><dd>{TYPES[u.type]}</dd>
<dt>Tools used</dt><dd><ul class="tools">{u.tools.map(t => <li>{t}</li>)}</ul></dd>
<dt>Browse by tool</dt><dd><ul class="tools">{toolLinks.map(g => <li class="tool-li"><a class="tool-link" href={`/tools/#${g.key}`}>{g.name}</a></li>)}</ul></dd>
{cost && (<><dt>Cost</dt><dd>{label(cost)}{cost.value}<small class="fact-note">{cost.note}{cost.url && <> <a href={cost.url} rel="noopener" target="_blank">{cost.basis === 'list-price' ? 'Vendor pricing page' : 'Source'} ↗<span class="sr-only"> (external site, opens in a new tab)</span></a></>}</small></dd></>)}
{setupTime && (<><dt>Setup time</dt><dd>{setupTime.value}<small class="fact-note">{setupTime.note}</small></dd></>)}
</dl></div>
<div class="panel source"><p class="side-label">Source</p><a href={u.sourceUrl} rel="noopener" target="_blank">Read the original: {u.sourceName} ↗<span class="sr-only"> (external site, opens in a new tab)</span></a>{missing.length > 0 && <p class="not-stated">Not stated in the source: {missing.join(', ')}.</p>}<p class="not-stated"><a href={`/use-cases/${u.slug}.md`} type="text/markdown">Plain-text (Markdown) version</a> for AI assistants and note-taking.</p><small>Details on this page are summarized from this source. Vendor case studies are written by the vendor; results are theirs, not ours.</small></div>
<div class="panel"><p class="side-label">Share this</p><div class="share">
<a href={`https://x.com/intent/post?text=${shareText}&url=${encodeURIComponent(url)}`} rel="noopener" aria-label="Share on X">X</a>
<a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} rel="noopener" aria-label="Share on Facebook">Facebook</a>
<a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} rel="noopener" aria-label="Share on LinkedIn">LinkedIn</a>
<a href={`mailto:?subject=${shareText}&body=${encodeURIComponent(url)}`} aria-label="Share by email">Email</a></div></div>
</aside>
</div>
{related.length > 0 && (<section style="margin-top:48px"><h2 class="section-title">More for {TYPES[u.type].toLowerCase()}</h2><div class="grid">{related.map(r => <Card u={r} />)}</div></section>)}
{sameTool.length > 0 && (<section style="margin-top:40px"><h2 class="section-title">Other businesses using {myGroups.length === 1 ? myGroups[0].name : 'the same AI tools'}</h2><div class="grid">{sameTool.map(({ x }) => <Card u={x} />)}</div><p><a class="see-all-tools" href={`/tools/#${toolLinks[0].key}`}>See every use case by AI tool →</a></p></section>)}
</Base>
