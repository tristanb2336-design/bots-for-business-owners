---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { TYPES } from '../../data/usecases.mjs';
import { groupByJob } from '../../data/jobs.mjs';
import { SITE, NAME } from '../../site.mjs';
export function getStaticPaths(){ return groupByJob().map(g => ({ params: { job: g.key }, props: { g } })); }
const { g } = Astro.props;
const list = g.list;
const path = `/jobs/${g.key}/`, url = SITE + path;
const types = [...new Set(list.map(u => u.type))].map(t => TYPES[t]);
const desc = `${list.length} real, sourced examples of small businesses using AI for ${g.name.toLowerCase()}: what it does for them, stated results and how to start.`;
const others = groupByJob().filter(x => x.key !== g.key);
const jsonld = { '@context':'https://schema.org','@graph':[
  { '@type':'CollectionPage', name:`${g.name}: small business AI use cases`, url, description:desc, inLanguage:'en-US',
    isPartOf:{ '@id':SITE+'/#website' }, publisher:{ '@id':SITE+'/#organization' },
    mainEntity:{ '@type':'ItemList', numberOfItems:list.length, itemListElement: list.map((u,i)=>({ '@type':'ListItem', position:i+1, url:`${SITE}/use-cases/${u.slug}/`, name:u.title })) } },
  { '@type':'BreadcrumbList', itemListElement:[
    { '@type':'ListItem', position:1, name:'Use cases', item:SITE+'/' },
    { '@type':'ListItem', position:2, name:'By job', item:SITE+'/jobs/' },
    { '@type':'ListItem', position:3, name:g.name, item:url } ] } ] };
---
<Base title={`${g.name}: ${list.length} real small business AI example${list.length===1?'':'s'}`} description={desc} path={path} jsonld={jsonld} markdown={`/jobs/${g.key}.md`} feed={{ href: `/jobs/${g.key}/rss.xml`, title: `${NAME}: ${g.name} (RSS)` }}>
<p class="crumbs"><a href="/">Use cases</a> / <a href="/jobs/">By job</a> / {g.name}</p>
<section class="hero" style="padding-top:12px"><span class="eyebrow">By job</span>
<h1>{g.name}</h1>
<p class="lead">{list.length} real example{list.length===1?'':'s'}, each linked to its public source. {g.blurb}</p>
<p class="biz" style="font-size:.95rem"><b>Business types:</b> {types.join(', ')}. We're <a href="/about/">vendor-neutral</a>: this page groups examples by the job described in the source and doesn't rank tools.</p>
</section>
<div class="grid">{list.map(u => <Card u={u} />)}</div>
<section class="panel prose" aria-labelledby="h-other-jobs"><h2 id="h-other-jobs">Other jobs</h2>
<ul class="tools">{others.map(x => <li class="tool-li"><a class="tool-link" href={`/jobs/${x.key}/`}>{x.name} ({x.list.length})</a></li>)}</ul></section>
<p class="biz" style="font-size:.9rem">Follow only this job: <a href={`/jobs/${g.key}/rss.xml`}>RSS feed</a> (new entries, newest first). For AI assistants: <a href={`/jobs/${g.key}.md`}>this list as plain Markdown</a>.</p>
<p><a class="btn btn-ghost" href="/jobs/">← All use cases by job</a></p>
</Base>
