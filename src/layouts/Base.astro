---
import { SITE, NAME, TAGLINE } from '../site.mjs';
const { title, description, path = '/', jsonld = null, ogType = 'website', published = null, section = null } = Astro.props;
const OG_ALT = `${NAME}: real, sourced examples of small businesses using AI agents`;
const url = SITE + path;
// Sitewide entity graph: one Organization (publisher) and one WebSite with stable @ids, so every page's JSON-LD
// (Article publisher, CollectionPage isPartOf, Dataset creator) can point at the same entities.
const siteGraph = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Organization', '@id': SITE + '/#organization', name: NAME, url: SITE + '/', logo: SITE + '/og.png',
    description: 'A free, vendor-neutral directory of real, sourced examples of small businesses using AI agents.',
    publishingPrinciples: SITE + '/about/', ethicsPolicy: SITE + '/about/',
    contactPoint: { '@type': 'ContactPoint', contactType: 'editorial and sponsorship', url: SITE + '/contact/' },
    sameAs: ['https://github.com/tristanb2336-design/bots-for-business-owners'] },
  { '@type': 'WebSite', '@id': SITE + '/#website', name: NAME, url: SITE + '/', description: TAGLINE, inLanguage: 'en-US',
    publisher: { '@id': SITE + '/#organization' } } ] };
const full = (path === '/' || title.includes(NAME)) ? title : `${title} | ${NAME}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{full}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta name="robots" content="index,follow,max-image-preview:large" />
<meta property="og:site_name" content={NAME} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={full} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={SITE + '/og.png'} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={OG_ALT} />
<meta property="og:locale" content="en_US" />
{published && <meta property="article:published_time" content={published} />}
{section && <meta property="article:section" content={section} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={full} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={SITE + '/og.png'} />
<meta name="twitter:image:alt" content={OG_ALT} />
<link rel="alternate" type="text/plain" title="LLM index" href="/llms.txt" />
<link rel="alternate" type="application/rss+xml" title="Bots for Business Owners: new AI use cases" href="/rss.xml" />
<link rel="alternate" type="application/json" title="Bots for Business Owners: all use cases (JSON)" href="/use-cases.json" />
<link rel="sitemap" href="/sitemap.xml" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
<script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<link rel="preload" href="/fonts/fraunces-700.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
<meta name="theme-color" content="#fbf6ee" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1a1613" media="(prefers-color-scheme: dark)" />
<style is:global>
@font-face{font-family:Fraunces;src:url(/fonts/fraunces-700.woff2) format('woff2');font-weight:600 800;font-display:swap}
@font-face{font-family:Inter;src:url(/fonts/inter-400.woff2) format('woff2');font-weight:300 450;font-display:swap}
@font-face{font-family:Inter;src:url(/fonts/inter-600.woff2) format('woff2');font-weight:451 800;font-display:swap}
:root{color-scheme:light dark;
--bg:#fbf6ee;--surface:#ffffff;--ink:#2a211b;--mut:#6b5d52;--line:#ece2d4;
--brand:#b53d0b;--ctl:#8f7f70;--brand-ink:#9a3412;--brand-soft:#fde7d6;--leaf:#166534;--leaf-soft:#dcf2e3;--sun:#fef3c7;--shadow:0 1px 2px rgba(60,40,20,.06),0 8px 24px rgba(60,40,20,.07)}
@media (prefers-color-scheme:dark){:root{--bg:#1a1613;--surface:#241e1a;--ink:#f5ede4;--mut:#c4b5a6;--line:#3a312a;--ctl:#7a6a5c;--brand:#fb923c;--brand-ink:#fdba74;--brand-soft:#3b2416;--leaf:#86efac;--leaf-soft:#173322;--sun:#3a2f14;--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.25)}}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}
body{margin:0;font:400 17px/1.65 Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink);background:var(--bg)}
h1,h2,h3,.logo{font-family:Fraunces,Georgia,"Times New Roman",serif;letter-spacing:-.01em;line-height:1.2}
a{color:var(--brand-ink);text-underline-offset:3px}a:hover{color:var(--brand)}
:focus-visible{outline:3px solid var(--brand);outline-offset:3px}
.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;background:var(--surface);padding:12px 16px;font-weight:600;border-radius:8px;box-shadow:var(--shadow);z-index:9}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.site-head{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.site-head .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:64px;flex-wrap:wrap}
.logo{font-weight:700;font-size:1.2rem;color:var(--ink);text-decoration:none;display:flex;align-items:center;gap:10px}
.logo .short{display:none}.logo-mark{display:grid;place-items:center;width:36px;height:36px;border-radius:10px;background:var(--brand);color:#fff;font-size:1.1rem}
.nav{display:flex;gap:4px;flex-wrap:wrap}.nav a{padding:8px 12px;border-radius:999px;text-decoration:none;color:var(--ink);font-weight:500;font-size:.95rem}
.nav a:hover,.nav a[aria-current=page]{background:var(--brand-soft);color:var(--brand-ink)}
main{padding-bottom:48px}
.hero{padding:56px 0 36px;text-align:left}
.eyebrow{display:inline-block;font-weight:600;font-size:.85rem;letter-spacing:.06em;text-transform:uppercase;color:var(--leaf);background:var(--leaf-soft);padding:4px 12px;border-radius:999px}
.hero h1{font-size:clamp(2.1rem,5vw,3.4rem);margin:16px 0 14px;max-width:16ch}
.hero h1 em{font-style:normal;color:var(--brand)}
.hero p.lead{font-size:clamp(1.05rem,2vw,1.25rem);color:var(--mut);max-width:58ch;margin:0 0 24px}
.cta{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:12px;font-weight:600;text-decoration:none;border:1px solid transparent}
.btn-primary{background:var(--brand);color:#fff}.btn-primary:hover{color:#fff;filter:brightness(1.07)}
@media (prefers-color-scheme:dark){.btn-primary{color:#1a1613}.btn-primary:hover{color:#1a1613}}
.btn-ghost{border-color:var(--line);background:var(--surface);color:var(--ink)}
.trust{display:flex;gap:20px;flex-wrap:wrap;margin-top:26px;color:var(--mut);font-size:.93rem}.trust span::before{content:"✓ ";color:var(--leaf);font-weight:700}
.section-title{font-size:1.5rem;margin:8px 0 4px}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0 8px}
.chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:999px;padding:8px 14px;cursor:pointer;font:500 .93rem Inter,system-ui,sans-serif;text-decoration:none;min-height:40px}
.chip:hover{border-color:var(--brand)}.chip[aria-pressed=true]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.chip .n{opacity:.65;font-size:.85em}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:18px;margin:20px 0}
.card{position:relative;display:flex;flex-direction:column;gap:10px;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:20px;text-decoration:none;color:inherit;box-shadow:var(--shadow);transition:transform .15s ease,border-color .15s ease}
.card:hover{transform:translateY(-2px);border-color:var(--brand);color:inherit}
.card h3{margin:0;font-size:1.13rem;font-weight:700}.card p{margin:0;color:var(--mut);font-size:.94rem}
.card .biz{font-size:.85rem;color:var(--mut);font-weight:500}
.card .more{margin-top:auto;font-weight:600;color:var(--brand-ink);font-size:.92rem}
.badge{display:inline-flex;align-items:center;gap:6px;align-self:flex-start;background:var(--brand-soft);color:var(--brand-ink);border-radius:999px;padding:3px 10px;font-size:.8rem;font-weight:600}
.badge .ic{font-size:1rem}
@media (prefers-reduced-motion:reduce){.card{transition:none}.card:hover{transform:none}}
.types{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin:16px 0 8px}
.type-tile{display:flex;flex-direction:column;gap:4px;padding:16px;border-radius:14px;background:var(--surface);border:1px solid var(--line);text-decoration:none;color:var(--ink);font-weight:600}
.type-tile .ic{font-size:1.6rem}.type-tile small{color:var(--mut);font-weight:400}.type-tile:hover{border-color:var(--brand);color:var(--ink)}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:var(--shadow);margin:24px 0}
.panel h2{margin-top:0}
.signup{background:linear-gradient(135deg,var(--brand-soft),var(--sun));border:0}
.hero-split{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:40px;align-items:center}
.hero-card{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:24px;box-shadow:var(--shadow)}
.hero-card .hc-title{font-family:Fraunces,Georgia,serif;font-weight:700;font-size:1.15rem;margin:0 0 12px}
.hero-card ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}.hero-card li{display:flex;gap:12px;align-items:center;padding:10px 12px;border-radius:12px;background:var(--bg);font-weight:500}
.hero-card li span{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--brand-soft)}
@media (max-width:860px){.hero-split{grid-template-columns:1fr}.hero-card{display:none}}
/* entry */
.crumbs{font-size:.9rem;color:var(--mut);margin:24px 0 8px}.crumbs a{color:var(--mut)}
.entry-head h1{font-size:clamp(1.8rem,4vw,2.6rem);margin:12px 0 10px;max-width:24ch}
.entry-head .biz{font-size:1.1rem;color:var(--mut);margin:0}
.entry{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:32px;margin-top:28px;align-items:start}
@media (max-width:860px){.entry{grid-template-columns:1fr}}
.prose h2{font-size:1.3rem;margin:28px 0 8px}.prose h2:first-child{margin-top:0}
.prose ul,.prose ol{padding-left:1.2em}.prose li{margin:6px 0}
.results{background:var(--leaf-soft);border-radius:14px;padding:16px 20px}.results h2{margin-top:0!important;color:var(--leaf)}
.steps{counter-reset:s;list-style:none;padding:0!important}.steps li{counter-increment:s;position:relative;padding-left:48px;margin:20px 0!important;line-height:1.55}
.steps li::before{content:counter(s);position:absolute;left:0;top:0;width:34px;height:34px;border-radius:50%;background:var(--brand);color:#fff;display:grid;place-items:center;font-weight:700;font-size:.9rem}
@media (prefers-color-scheme:dark){.steps li::before{color:#1a1613}}
.side{position:sticky;top:84px;display:flex;flex-direction:column;gap:16px}
.side .panel{margin:0;padding:20px}.side h2{font-size:1.05rem;margin:0 0 8px}
.facts dt{font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;color:var(--mut);font-weight:600;margin-top:12px}.facts dt:first-child{margin-top:0}.facts dd{margin:2px 0 0}
.tools{display:flex;flex-wrap:wrap;gap:6px;list-style:none;padding:0;margin:4px 0 0}.tools li{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:2px 8px;font-size:.88rem}
.source{background:var(--sun);border:1px solid color-mix(in srgb,var(--brand) 25%,transparent)}
.source small{color:var(--mut);display:block;margin-top:8px;line-height:1.5}
.share{display:flex;gap:8px;flex-wrap:wrap}.share a{font-size:.88rem;padding:6px 12px;border-radius:999px;border:1px solid var(--line);text-decoration:none;color:var(--ink);background:var(--surface)}
.site-foot{border-top:1px solid var(--line);background:var(--surface);color:var(--mut);font-size:.93rem;padding:36px 0}
.site-foot .wrap{display:grid;grid-template-columns:2fr 1fr;gap:24px}.site-foot nav{display:flex;flex-direction:column;gap:6px}
@media (max-width:640px){.site-foot .wrap{grid-template-columns:1fr}.hero{padding:36px 0 24px}.nav a{padding:6px 10px}}
.chip,.type-tile,.btn,.btn-ghost,.share a,.signup-form input,.signup-form button,.contact-form input,.contact-form button,.card,.panel,.quick li{border-color:var(--ctl)}
.tool-link,.see-all-tools{display:inline-flex;align-items:center;min-height:44px;padding:0 4px}.tools li.tool-li{padding:0 6px}
.fact-note{display:block;margin-top:4px;color:var(--mut);font-size:.82rem}.not-stated{margin:10px 0 6px;font-size:.88rem;color:var(--mut)}
.logo{min-height:44px}.js-paged .card.is-hidden{display:none}.more-wrap{text-align:center;margin:20px 0 8px}#show-more{min-height:48px}.fact-note a{display:inline-block;padding:12px 0}.lp-note{display:block;margin-top:4px;font-size:.8rem;color:var(--mut)}
@media (max-width:340px){.logo .short{display:none!important}.nav a{padding:0 5px;font-size:.85rem;white-space:normal}}
.nav a,.share a{min-height:44px;display:inline-flex;align-items:center}.chip{min-height:44px}
.site-foot nav{gap:0}.site-foot nav a{padding:10px 0;display:block}
.crumbs a{display:inline-block;padding:12px 2px}
.source a{display:inline-block;padding:10px 0;font-weight:600}
.link-quiet{display:inline-flex;align-items:center;min-height:44px;padding:0 6px;font-weight:600}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.side-label{font-family:Fraunces,Georgia,serif;font-weight:700;font-size:1.05rem;margin:0 0 8px}
.quick{list-style:none;padding:0;margin:18px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.quick li{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 14px;display:grid;grid-template-columns:auto 1fr;column-gap:10px;align-items:start;line-height:1.45}
.quick li>span{grid-row:span 2;font-size:1.3rem}.quick b{font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;color:var(--mut)}
.quick .ns{color:var(--mut);font-style:italic}
.card .win{color:var(--leaf);font-weight:600;font-size:.94rem}.card .meta{font-size:.85rem;color:var(--mut);font-weight:500}
.signup-form label{display:block;font-weight:600;margin-bottom:6px}
.signup-form .row{display:flex;gap:8px;flex-wrap:wrap}
.signup-form input{flex:1 1 220px;min-height:48px;padding:0 14px;border:1px solid;border-radius:12px;font:inherit;background:var(--surface);color:var(--ink)}
.signup-form button{min-height:48px;cursor:pointer;font:inherit;font-weight:600}
.contact-form{display:grid;gap:4px;max-width:640px}.contact-form label{margin-top:10px}.contact-form select,.contact-form textarea{min-height:48px;padding:10px 14px;border:1px solid var(--ctl);border-radius:12px;font:inherit;background:var(--surface);color:var(--ink)}.contact-form .row{margin-top:14px}
.signup-form small{display:block;margin-top:8px;color:var(--mut)}
.signup-form .done{margin:10px 0 0;font-weight:600;color:var(--leaf)}
@media (max-width:640px){
  .site-head .wrap{flex-wrap:nowrap;min-height:56px;gap:6px}
  .logo{font-size:.92rem;gap:8px;min-height:44px;line-height:1.05;flex-shrink:0}.logo .full{display:none}.logo .short{display:inline}.nav a{white-space:nowrap}.logo-mark{width:32px;height:32px}
  .nav{flex-wrap:nowrap;gap:0}.nav a{padding:0 6px;font-size:.88rem}
  .types{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:10px;margin-inline:-20px;padding:4px 20px 12px}
  .type-tile{flex:0 0 150px;scroll-snap-align:start;min-height:96px}
  .hero{padding:24px 0 16px}.hero .lead{font-size:1.05rem}.trust{margin-top:16px;gap:6px 16px}
  .side{position:static}
}
.featured{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:12px;margin:16px 0}.feat{border:2px dashed var(--ctl)}.feat-badge{background:var(--sun);color:var(--ink)}.feat-note{grid-column:1/-1;margin:0;font-size:.85rem;color:var(--mut)}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head"><div class="wrap"><a class="logo" href="/"><span class="logo-mark" aria-hidden="true">🤖</span><span>Bots<span class="full"> for Business Owners</span><span class="short"> for<br>Owners</span></span></a>
<nav class="nav" aria-label="Main"><a href="/" aria-current={path==='/'?'page':undefined}>Use cases</a><a href="/about/" aria-current={path==='/about/'?'page':undefined}>About</a><a href="/newsletter/" aria-current={path==='/newsletter/'?'page':undefined}>Newsletter</a></nav></div></header>
<main id="main" class="wrap"><slot /></main>
<footer class="site-foot"><div class="wrap">
<div><p style="margin-top:0"><strong style="color:var(--ink);font-family:Fraunces,Georgia,serif;font-size:1.1rem">{NAME}</strong></p>
<p>A free directory of real AI-agent use cases for non-technical small business owners. Every entry links to its public source. Paid placements are always labeled and never change the editorial use cases.</p></div>
<nav aria-label="Footer"><a href="/about/">About</a><a href="/tools/">Use cases by AI tool</a><a href="/newsletter/">Hands Free newsletter</a><a href="/advertise/">Advertise / Get featured</a><a href="/contact/">Contact</a><a href="/sitemap.xml">Sitemap</a><a href="/rss.xml">RSS feed</a><a href="/llms.txt">llms.txt</a><a href="https://github.com/tristanb2336-design/bots-for-business-owners">GitHub</a></nav>
</div></footer>
</body>
</html>
