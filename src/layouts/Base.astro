---
import { SITE, NAME } from '../site.mjs';
const { title, description, path = '/', jsonld = null, ogType = 'website' } = Astro.props;
const url = SITE + path;
const full = path === '/' ? title : `${title} | ${NAME}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{full}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta name="robots" content="index,follow,max-image-preview:large" />
<meta property="og:site_name" content={NAME} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={full} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={SITE + '/og.png'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={full} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={SITE + '/og.png'} />
<link rel="alternate" type="text/plain" title="LLM index" href="/llms.txt" />
<link rel="sitemap" href="/sitemap.xml" />
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🤖</text></svg>" />
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<style is:global>
:root{--g:#14532d;--bg:#fffdf7;--ink:#1c1917;--mut:#57534e;--card:#fff;--line:#e7e5e4}
*{box-sizing:border-box}body{margin:0;font:17px/1.6 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--ink);background:var(--bg)}
a{color:var(--g)}header,main,footer{max-width:920px;margin:auto;padding:0 20px}
header{display:flex;justify-content:space-between;align-items:center;padding-top:18px;flex-wrap:wrap;gap:8px}
header .logo{font-weight:800;text-decoration:none;color:var(--ink);font-size:1.15rem}header nav a{margin-left:16px;text-decoration:none}
h1{font-size:2rem;line-height:1.2;margin:28px 0 12px}h2{margin-top:32px;font-size:1.25rem}
.lead{font-size:1.15rem;color:var(--mut)}.pill{display:inline-block;background:#dcfce7;color:var(--g);border-radius:99px;padding:2px 10px;font-size:.85rem;font-weight:600}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:14px;margin:18px 0}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;text-decoration:none;color:inherit;display:block}.card:hover{border-color:var(--g)}
.card h3{margin:8px 0 6px;font-size:1.05rem;line-height:1.35}.card p{margin:0;color:var(--mut);font-size:.93rem}
.filters button,.filters a.btn{border:1px solid var(--line);background:#fff;border-radius:99px;padding:6px 12px;margin:3px;cursor:pointer;font:inherit;font-size:.9rem;text-decoration:none;color:var(--ink)}
.filters button[aria-pressed=true]{background:var(--g);color:#fff;border-color:var(--g)}
.box{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px 20px;margin:16px 0}
.src{background:#fef3c7;border-color:#fcd34d}footer{color:var(--mut);font-size:.9rem;padding:40px 20px}
.share a{margin-right:12px}
</style>
</head>
<body>
<header><a class="logo" href="/">🤖 {NAME}</a><nav><a href="/">Use cases</a><a href="/about/">About</a><a href="/newsletter/">Newsletter</a></nav></header>
<main><slot /></main>
<footer>
<p>{NAME} is a free directory of real AI-agent use cases for non-technical small business owners. Every entry links to its public source. No paid placements.</p>
<p><a href="/sitemap.xml">Sitemap</a> · <a href="/llms.txt">llms.txt</a> · <a href="/about/">About</a></p>
</footer>
</body>
</html>
